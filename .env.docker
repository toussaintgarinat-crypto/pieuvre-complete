# ====================================================================
# Fichier .env - Configuration Docker
# ====================================================================

# Base de données
POSTGRES_DB=pieuvre_db
POSTGRES_USER=pieuvre_user
POSTGRES_PASSWORD=pieuvre_pass

# API
NODE_ENV=production
PORT=3001
DB_HOST=postgres
DB_PORT=5432
DB_NAME=pieuvre_db
DB_USER=pieuvre_user
DB_PASSWORD=pieuvre_pass

# Web (si utilisé)
WEB_URL=http://localhost:3000