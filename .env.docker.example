# ====================================================================
# Fichier .env - Configuration Docker (exemple)
# Copier ce fichier en .env.docker et adapter les valeurs si besoin
# ====================================================================

# Base de données
POSTGRES_DB=pieuvre_db
POSTGRES_USER=pieuvre_user
POSTGRES_PASSWORD=change_me

# API
NODE_ENV=production
PORT=3001
DB_HOST=postgres
DB_PORT=5432
DB_NAME=pieuvre_db
DB_USER=pieuvre_user
DB_PASSWORD=change_me

# Web (si utilisé)
WEB_URL=http://localhost

# RAG / Embeddings
# Fournisseurs: openai | openrouter
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_BASE=https://api.openai.com/v1
OPENROUTER_API_KEY=
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=Pieuvre Auto
RAG_MOCK_MODE=true

# OCR / Vision
# Fournisseurs: openai | anthropic | google | openrouter
VISION_PROVIDER=openai
VISION_API_KEY=
VISION_MODEL=gpt-4o-mini
VISION_API_BASE=https://api.openai.com/v1
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=Pieuvre Auto
VISION_MOCK_MODE=true
