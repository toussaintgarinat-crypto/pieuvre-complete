# ====================================================================
# PIEUVRE AUTO - Configuration Production
# ====================================================================

# Base de données
DB_NAME=pieuvre_db
DB_USER=pieuvre_user
DB_PASSWORD=changeme_strong_password
DB_PORT=5432

# API
API_PORT=3001
NODE_ENV=production

# Frontend
WEB_PORT=3000
WEB_URL=http://localhost:3000
VITE_API_URL=/api

# Domain (pour Traefik)
DOMAIN=localhost

# ====================================================================
# INSTRUCTIONS
# ====================================================================
#
# 1. Copier ce fichier vers .env et modifier les mots de passe
# 2. Lancer: docker-compose -f docker-compose.production.yml up -d
# 3. Accéder: http://localhost:3000
#
# ====================================================================