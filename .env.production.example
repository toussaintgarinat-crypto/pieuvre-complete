# ====================================================================
# PIEUVRE AUTO - Configuration Production
# ====================================================================

# Base de données
DB_NAME=pieuvre_db
DB_USER=pieuvre_user
DB_PASSWORD=changeme_strong_password
DB_PORT=5432

# API
API_PORT=3001
NODE_ENV=production

# Frontend
WEB_PORT=3000
WEB_URL=http://localhost:3000
VITE_API_URL=/api

# Domain (pour Traefik)
DOMAIN=localhost

# RAG / Embeddings
# Fournisseurs: openai | openrouter
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_BASE=https://api.openai.com/v1
OPENROUTER_API_KEY=sk-or-v1-
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_SITE_URL=https://pieuvre.example.com
OPENROUTER_APP_NAME=Pieuvre Auto
RAG_MOCK_MODE=false

# OCR / Vision
# Fournisseurs: openai | anthropic | google | openrouter
VISION_PROVIDER=openai
VISION_API_KEY=sk-your-openai-key
VISION_MODEL=gpt-4o-mini
VISION_API_BASE=https://api.openai.com/v1
OPENROUTER_API_KEY=sk-or-v1-
OPENROUTER_SITE_URL=https://pieuvre.example.com
OPENROUTER_APP_NAME=Pieuvre Auto
VISION_MOCK_MODE=false

# ====================================================================
# INSTRUCTIONS
# ====================================================================
#
# 1. Copier ce fichier vers .env et modifier les mots de passe
# 2. Lancer: docker-compose -f docker-compose.production.yml up -d
# 3. Accéder: http://localhost:3000
#
# ====================================================================