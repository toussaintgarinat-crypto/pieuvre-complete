# ====================================================================
# PIEUVRE API - Configuration Environnement
# ====================================================================

# PORT DE L'API
PORT=3001

# URL DE L'INTERFACE WEB (pour CORS)
WEB_URL=http://localhost:3000

# CONFIGURATION POSTGRESQL
DB_USER=postgres
DB_HOST=localhost
DB_NAME=pieuvre_db
DB_PASSWORD=postgres
DB_PORT=5432

# ENVIRONNEMENT (development | production)
NODE_ENV=development

# ====================================================================
# CONFIGURATION RAG / EMBEDDINGS
# ====================================================================
# Fournisseurs: openai | openrouter
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_BASE=https://api.openai.com/v1
# OpenRouter (alternative, compatible OpenAI)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=Pieuvre Auto
# Mode mock pour tester sans clé API: true | false
RAG_MOCK_MODE=false

# ====================================================================
# CONFIGURATION OCR / VISION
# ====================================================================
# Fournisseurs: openai | anthropic | google | openrouter
VISION_PROVIDER=openai
VISION_API_KEY=sk-...
VISION_MODEL=gpt-4o-mini
VISION_API_BASE=https://api.openai.com/v1
# Pour Anthropic: VISION_MODEL=claude-3-5-sonnet-20241022
# Pour Google: VISION_MODEL=gemini-1.5-flash
# Pour OpenRouter: VISION_MODEL=openai/gpt-4o-mini (ou anthropic/claude-3.5-sonnet, google/gemini-1.5-flash...)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=Pieuvre Auto
# Mode mock pour tester sans clé API: true | false
VISION_MOCK_MODE=false

# ====================================================================
# INSTRUCTIONS D'INSTALLATION
# ====================================================================
# 
# 1. Installer PostgreSQL 16
# 2. Créer la base de données:
#    psql -U postgres -c "CREATE DATABASE pieuvre_db;"
# 
# 3. Exécuter le schéma SQL:
#    psql -U postgres -d pieuvre_db -f ../pieuvre-database/schema.sql
# 
# 4. Installer les dépendances Node.js:
#    npm install
# 
# 5. Démarrer le serveur:
#    npm start
#    ou en mode développement avec auto-reload:
#    npm run dev
# 
# 6. Tester que tout fonctionne:
#    http://localhost:3001/health
# 
# ====================================================================
